<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="5" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.projetofx.LoginController"
      prefHeight="400.0" prefWidth="600.0">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"></Insets>
    </padding>

    <Label text="Nome de usuário"></Label>
    <TextField fx:id="txtNomeUsuario"></TextField>

    <Label text="Senha"></Label>
    <PasswordField fx:id="txtSenhaUsuario"></PasswordField>

    <Label fx:id="alertaLogin" visible="false" text="Nome de usuário e/ou senha incorretos."></Label>

    <HBox spacing="5" alignment="BASELINE_RIGHT">
        <Button fx:id="botaoSair" text="Sair"></Button>
        <Button fx:id="botaoEntrar" text="Entrar" onAction="#autenticar"></Button>
    </HBox>

</VBox>
